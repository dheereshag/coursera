# Coursera Settings
COURSERA_TIMEOUT_MS=30000
COURSERA_MAX_ITEMS=25
COURSERA_POST_QUIZ_WAIT_SEC=180

# OpenRouter LLM Settings
OPENROUTER_API_KEY="your-openrouter-api-key"

# Free Tier Models (Default)
OPENROUTER_MODEL="dots-studio/dots-3-note-preview:free"
OPENROUTER_FALLBACK_MODEL="qwen/qwen3.8-27b:free"

# Premium / Paid Models (Uncomment if using a paid OpenRouter account)
# OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"
# OPENROUTER_FALLBACK_MODEL="z-ai/glm-5.3-flash"

