# Coursera Credentials & Course Settings
COURSERA_LOGIN_URL="https://www.coursera.org"
COURSERA_COURSE_URL="https://www.coursera.org/specializations/generative-ai-for-software-developers"
COURSERA_EMAIL="user@example.com"
COURSERA_PASSWORD="YourPasswordHere"
COURSERA_HEADLESS=false
COURSERA_TIMEOUT_MS=30000
COURSERA_MAX_ITEMS=25
COURSERA_POST_QUIZ_WAIT_SEC=300

# OpenRouter LLM Settings
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="inclusionai/ling-3.0-flash-fin:free"
